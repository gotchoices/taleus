{
	"name": "taleus-monorepo",
	"version": "0.0.0",
	"description": "Taleus: MyCHIPs reboot on Sereus. Monorepo root.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "yarn@4.12.0",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "yarn workspaces foreach --all --topological run build",
		"test": "yarn workspaces foreach --all run test",
		"lint": "yarn workspaces foreach --all run lint"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/jest": "30.0.0",
		"@types/node": "26.1.1",
		"cross-env": "7.0.3",
		"eslint": "10.7.0",
		"globals": "17.7.0",
		"jest": "30.4.2",
		"ts-jest": "29.4.11",
		"typescript": "6.0.3",
		"typescript-eslint": "8.63.0"
	}
}
