{
	"name": "taleus-cli",
	"version": "0.1.0",
	"private": true,
	"description": "Taleus on the command line: a client for testing, evaluating and debugging Taleus. A client of taleus-model like the phone app.",
	"type": "module",
	"bin": {
		"taleus": "./src/main.ts"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node src/main.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test 'src/**/*.test.ts'",
		"scenarios": "node --test --test-concurrency=1 'scenarios/**/*.scenario.ts'"
	},
	"dependencies": {
		"taleus-core": "link:../../../taleus-core",
		"taleus-model": "link:../../../taleus-model",
		"taleus-sereus": "link:../../../taleus-sereus"
	}
}
