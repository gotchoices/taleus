{
	"name": "tallysim-viewer",
	"version": "0.1.0",
	"description": "TallySim Viewer: a static, server-less browser app that draws a simulated Taleus tally network and animates a payment search spreading across it. A development tool; its headless core (trace indexing, nonce de-anonymisation, playback state, sweep parsing) is unit-tested with no browser.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit -p tsconfig.json && vite build",
		"dev": "vite",
		"test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
		"lint": "eslint ./src"
	},
	"dependencies": {
		"graphology": "0.26.0",
		"graphology-layout-forceatlas2": "0.10.1",
		"graphology-types": "0.24.8",
		"sigma": "4.0.6",
		"tallynet": "workspace:^",
		"tallysim": "workspace:^",
		"uplot": "1.6.32"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/jest": "30.0.0",
		"@types/node": "26.1.1",
		"cross-env": "7.0.3",
		"eslint": "10.7.0",
		"globals": "17.7.0",
		"jest": "30.4.2",
		"ts-jest": "29.4.11",
		"typescript": "6.0.3",
		"typescript-eslint": "8.63.0",
		"vite": "6.4.2"
	}
}
