-- Single-party portfolio strand. sAppId taleus; cohort = this party's own cadre.
-- Private (never shared into a tally strand). No signatures: Sereus strand
-- membership is the only write gate. Insert-only + revisioned + latest-wins views.
--
-- Same sAppId, two schemas: the phone's one CadreNode runs a single strand filter
-- (sAppId:taleus), so both this portfolio strand and every two-party tally strand
-- (schema/draft1.qsql) share sAppId = taleus to be picked up. sAppId is a filter tag,
-- not a schema identity -- each Strand row names its own sApp schema. The app tells the
-- two apart by the PortfolioCore marker row below (a tally strand carries TallyCore
-- instead), not by member count alone (a tally mid-formation is also briefly one member).
--
-- NOTE: this strand carries the `interactive` latency hint (same as tally strands). The
-- always-on lift agent must read quotes / the lift journal at decision time even while the
-- strand hibernates; agent reads/writes wake it locally (../sereus/docs/architecture.md
-- § Strand Hibernation, local wake). The hint is set at strand creation (app-wiring, not
-- schema); recorded here so a reader knows this strand is expected to be interactive.
--
-- NOTE: insert-only + revisioned means TallyRegistry / LiftJournal / AppPreference grow
-- unboundedly as state churns (a 6-transition lift = 6 LiftJournal rows; a chatty balance
-- cache = one row per update). Fine now -- a portfolio holds hundreds of tallies, not
-- millions of rows. If a long-lived portfolio's revision history ever grows costly, add
-- compaction (drop superseded revisions). Safe precisely because these tables are private
-- and unsigned -- no audit/consensus reason to retain history (unlike the tally Ledger).
-- Tripwire only; do not build compaction now.

-- Singleton marker + owner identity. Presence of this row is how the app recognizes
-- a strand as *the* portfolio (vs a tally strand, which has TallyCore instead).
create table PortfolioCore (
    OwnerSid text,        -- this party's Sid; same identity used in its tally strands
    Version integer,      -- portfolio schema/protocol version
    Created text,
    primary key (/* 1 row */),
    constraint InsertOnly check on delete, update (0)
);

-- One logical entry per tally the party holds; revisioned. This is a *cache/index*
-- over the party's tally strands, not the authoritative tally state (that lives in
-- each tally strand). Reconstructible from CadreControl.Strand + reading each tally.
create table TallyRegistry (
    StrandId text,                       -- the tally strand's id
    Revision integer,
    Role text check (Role in ('S', 'F')),  -- this party's seat: Stock or Foil
    CounterpartySid text,
    Denomination text,                   -- cached from the tally's accepted contract
    DenominationScale integer,
    State text,                          -- forming|open|closing|closed|void (cached)
    -- NOTE: display-only cache. Authoritative source is the tally strand, which can advance
    -- while hibernating (the counterparty writes a chit); refreshed opportunistically when the
    -- tally wakes. Reads that must be exact (a payment amount) read the tally strand, not this.
    CounterpartyCertificate text null,   -- cached cert (display w/o waking the tally)
    BalanceCache integer null,           -- last-known perspective balance (display only)
    Updated text,
    primary key (StrandId, Revision),
    constraint RevisionMonotonicInt check on insert (Revision = Coalesce((select max(Revision) from committed.TallyRegistry T where T.StrandId = New.StrandId), 0) + 1),
    constraint InsertOnly check on delete, update (0)
);
create view CurrentTallyRegistry as
    select R.* from TallyRegistry R
    where R.Revision = (select max(Revision) from TallyRegistry T2 where T2.StrandId = R.StrandId);

-- In-flight lift bookkeeping: the agent's cross-tally correlation of a lift in progress.
-- The authoritative per-edge state is the pending lift chit in each tally strand's Ledger;
-- this journal is the private "which lift, which edges, what state" map the agent needs to
-- drive discovery/commit across strands. Revisioned; advances by appending a new State.
create table LiftJournal (
    LiftId text,
    Revision integer,
    Role text check (Role in ('O', 'I', 'P')),   -- Originator | Intermediary | Payee
    State text,                                 -- proposed|discovering|pending|committed|aborted|timedout
    Edges text,                                 -- JSON: [{ strandId, denom, units, direction }]
    Referee text null,
    Updated text,
    primary key (LiftId, Revision),
    constraint RevisionMonotonicInt check on insert (Revision = Coalesce((select max(Revision) from committed.LiftJournal J where J.LiftId = New.LiftId), 0) + 1),
    constraint InsertOnly check on delete, update (0)
);
create view CurrentLift as
    select J.* from LiftJournal J
    where J.Revision = (select max(Revision) from LiftJournal J2 where J2.LiftId = J.LiftId);

-- App preferences: key/value, revisioned (e.g. display currency, notification prefs).
create table AppPreference (
    Key text,
    Revision integer,
    Value text,
    Updated text,
    primary key (Key, Revision),
    constraint RevisionMonotonicInt check on insert (Revision = Coalesce((select max(Revision) from committed.AppPreference P where P.Key = New.Key), 0) + 1),
    constraint InsertOnly check on delete, update (0)
);
create view CurrentPreference as
    select P.* from AppPreference P
    where P.Revision = (select max(Revision) from AppPreference P2 where P2.Key = P.Key);

-- Exchange rate quotes: the party's private trading policy for converting value between
-- the denominations of its own tallies. Read only by the party's own lift agent at decision
-- time; NEVER shared into a tally strand -- unlike TradingVariable (schema/draft1.qsql),
-- which is published per-tally for the counterparty to read. Insert-only, revisioned,
-- unsigned -- strand membership is the sole write gate, same as the rest of this file.
--
-- Directional: a currency pair needs two rows (From->To and To->From) because the spread is
-- asymmetric. RateNum/RateDen is the *effective* rate with the party's conversion cost (spread)
-- already folded in -- the multi-denomination generalization of TradingVariable.Reward.
-- Mid*/SpreadPpm are optional display fields for re-deriving the effective rate; a negative
-- SpreadPpm (subsidy) is permitted, mirroring Reward's signed semantics.
--
-- Display-level, scale-independent: the rate is defined at each denomination's *display* unit
-- (1 USD, 1 CHIP), not at smallest-unit granularity, so a quote is independent of any tally's
-- per-contract scale. Scales enter only at conversion time, from each edge's contract.
create table ExchangeRateQuote (
    FromDenom text,                           -- convert-FROM denom = D_in in the conversion NOTE below: the upstream (payer-side) edge; value the quoting party RECEIVES/accumulates
    ToDenom text,                             -- convert-TO   denom = D_out in the conversion NOTE below: the downstream (payee-side) edge; value the quoting party RELEASES/pays out
    Revision integer,
    RateNum integer check (RateNum > 0),      -- effective rate (spread folded in): FromDisplay units per ToDisplay unit
    RateDen integer check (RateDen > 0),      -- rational RateNum/RateDen, for integer-exact conversion
    MidNum integer null,                      -- optional: mid-market rate before spread (display / re-derivation)
    MidDen integer null,
    SpreadPpm integer null,                   -- optional: spread applied, parts-per-million (display; negative = subsidy)
    ValidFrom text,                           -- date; quote usable from (inclusive)
    ValidUntil text,                          -- date; quote usable until (inclusive)
    Updated text,
    primary key (FromDenom, ToDenom, Revision),
    constraint ValidWindow check on insert (ValidUntil >= ValidFrom),
    constraint RevisionMonotonicInt check on insert (Revision = Coalesce((select max(Revision) from committed.ExchangeRateQuote Q where Q.FromDenom = New.FromDenom and Q.ToDenom = New.ToDenom), 0) + 1),
    constraint InsertOnly check on delete, update (0)
);
-- Latest revision per direction. The lift agent then filters by validity window at decision
-- time (ValidFrom <= now <= ValidUntil): a pair whose latest revision is out of window has no
-- usable quote, so that conversion boundary is pruned from the route (the agent must never
-- fabricate a rate). Committed lift terms bind regardless of later expiry -- the quoting party
-- bears any rate movement between quote and commit, bounded by the window it chose.
create view CurrentExchangeRateQuote as
    select Q.* from ExchangeRateQuote Q
    where Q.Revision = (select max(Revision) from ExchangeRateQuote Q2 where Q2.FromDenom = Q.FromDenom and Q2.ToDenom = Q.ToDenom);

-- NOTE: cross-denomination conversion math. The formula below is the contract that
-- src/lift/convert.ts (convertBoundary) implements -- this rate definition is where the
-- contract is documented; that file mirrors it at the actual req_in computation site.
-- Value flows payer->payee; discovery walks the route
-- backward from the payee. At each boundary the downstream tally (nearer payee) is D_out at
-- scale s_out with required smallest-units req_out; the upstream tally (nearer payer) is D_in at
-- scale s_in; the intermediary quotes RateNum/RateDen for From=D_in, To=D_out. Required upstream
-- smallest-units:
--   req_in = ceil( req_out * RateNum * 10^(s_in) / ( RateDen * 10^(s_out) ) )
-- Round UP so the downstream party is never shorted; the sub-unit remainder (< 1 smallest-unit
-- of D_in per edge) is borne upstream, cascading to the originator (the payer for a linear lift /
-- payment, the initiator for a circular clearing lift). Degenerate single-denomination case
-- (RateNum=RateDen=1, s_in=s_out) makes the ceiling a no-op -- exactly MyCHIPs behavior.
--
-- NOTE: OVERFLOW STRATEGY -- decided; do NOT "optimize" this back to a native 64-bit multiply.
-- Reduce RateNum/RateDen to lowest terms, then compute req_out*RateNum*10^(s_in) with BigInt
-- (cross-platform) and take the ceiling via integer division. Large amount x large rate x large
-- scale overflows 64 bits otherwise. See src/lift/convert.ts for the landed implementation.
--
-- NOTE: rounding-dust accumulation (tripwire) -- a route of N conversion boundaries can add up to
-- N sub-units of extra originator cost. Bounded and acceptable now; only matters if very long
-- routes ever appear. If they do, revisit whether the dust should be redistributed rather than
-- all borne by the originator.
