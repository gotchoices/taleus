create table Stock (
    Sid text,
    InvitationKey text,    --public key of sk sent to invited party
    SignerKey text,        -- authorized PartyKey of Sid that signed this row
    Signature text null,    -- Signed using party key

    primary key (/* 1 row */),
    constraint SignerAuthorized check on insert (New.SignerKey in (select PublicKey from AuthorizedKey AK where AK.Sid = New.Sid)),
    constraint SignatureValid check on insert (SignatureValid(
        Digest(
            Sid,
            InvitationKey
        ),
        Signature,
        New.SignerKey
    )),
    constraint InsertOnly check on delete, update (0)
);

create table Foil (
    Sid text,
    Signature text,  -- signed using the out of band exchanged private key
    
    primary key (Sid),
    constraint InvitationSignatureValid check on insert (SignatureValid(
        Digest(Sid), 
        Signature, 
        (select InvitationKey from Stock)
    )),
    constraint PartyExists check on insert ((select count(*) from PartyKey PK where PK.Sid = New.Sid)),
    constraint InsertOnly check on delete, update (0)
);

-- PartyKey is an authorized-key SET with revocation, not a sole-authority chain.
-- The party's identity (Sid) is the hash of the genesis (Revision 1) public key and
-- never changes; the authorized set of keys evolves under it. Any currently-authorized,
-- non-revoked key may authorize (add) another; any authorized key may revoke another
-- (see PartyKeyRevocation). This mirrors Sereus's multi-authority cadre AuthorityKey
-- model rather than inventing a parallel scheme.
--
-- Deferred-constraint semantics matter here. A CHECK containing a subquery is evaluated
-- at COMMIT (Quereus auto-defers it). A plain `from PartyKey` there reads the
-- buffered+committed view, so it INCLUDES the row being inserted; `from committed.PartyKey`
-- reads the pre-transaction snapshot, so it EXCLUDES it. Each constraint below picks the
-- snapshot its logic requires.
create table PartyKey (
    Sid text,               -- party identity: Cid hash of the genesis (Revision 1) public key; never changes
    Revision integer,       -- per-Sid monotonic sequence of key-add events (ordering, not a sole-authority chain)
    PublicKey text,         -- the key being authorized
    AuthKey text null,      -- currently-authorized PublicKey that authorized this add; null for Revision 1 (genesis)
    Signature text,         -- Revision 1: signed by the invitation key; else: signed by AuthKey

    primary key (Sid, Revision),
    -- Prior max comes from committed.* so the row being inserted is excluded -- a plain
    -- self-reference would see this same new row and make `Revision = max + 1` unsatisfiable.
    -- Concurrent adds from two surviving devices both read the same committed max and both
    -- compute Revision N+1; the (Sid, Revision) primary key + Optimystic write ordering then
    -- serialize them, rejecting the loser. No constraint assumes a single writer.
    constraint RevisionMonotonicInt check on insert (Revision = Coalesce((select max(Revision) from committed.PartyKey PK where PK.Sid = New.Sid), 0) + 1),
    -- The new row IS visible here (plain ref), so a genuinely-unique PublicKey yields exactly
    -- one match. A revoked key can never be re-added: its PartyKey row is insert-only and
    -- stays, so a re-add of the same PublicKey makes the count 2 and fails.
    constraint UniqueKey check on insert ((select count(*) from PartyKey PK where PK.Sid = New.Sid and PK.PublicKey = New.PublicKey) = 1),
    -- The authorizing key must have been in the party's authorized set as of the
    -- pre-transaction snapshot -- registered either as a normal add (committed.PartyKey) OR as a
    -- counterparty adoption (committed.PartyKeyAdoption), and not revoked by a committed
    -- revocation. Including committed.PartyKeyAdoption is REQUIRED for recovery to complete: after
    -- a total-loss adoption the only surviving key is the adopted one, and the party must be able
    -- to authorize its fresh device keys with it (see docs "Key recovery"; without this an adopted
    -- key could sign existing tables but never add further keys). Using committed.* rather than the
    -- live AuthorizedKey/RegisteredKey view is a SECURITY requirement: the live view already
    -- contains this new row, so a self-authorizing add (AuthKey = New.PublicKey) would validate
    -- itself and mint authority from nothing. committed.* also excludes an adoption inserted in the
    -- SAME transaction, so an add cannot bootstrap off an adoption that has not itself committed.
    constraint AuthKeyAuthorized check on insert (
        New.Revision = 1
        or (
            (New.AuthKey in (select PK.PublicKey from committed.PartyKey PK where PK.Sid = New.Sid)
             or New.AuthKey in (select A.PublicKey from committed.PartyKeyAdoption A where A.Sid = New.Sid))
            and not exists (select 1 from committed.PartyKeyRevocation R where R.Sid = New.Sid and R.PublicKey = New.AuthKey)
        )
    ),
    -- Genesis validates against the invitation key (via Stock); every later add against the
    -- key that authorized it. Reuses the single-key SignatureValid primitive -- no new crypto.
    constraint SignatureValid check on insert (SignatureValid(
        Digest(Sid, Revision, PublicKey, AuthKey),
        Signature,
        case when Revision = 1 then (select InvitationKey from Stock) else AuthKey end
    )),
    constraint InsertOnly check on delete, update (0),
    -- Never introduce a third party. The new row's Sid is counted (plain ref).
    constraint TwoParties check on insert ((select count(distinct Sid) from PartyKey) <= 2)
);

-- Forward-only revocation of an authorized key. Rows already committed under the key stay
-- valid -- they are insert-only, their signature was checked once at their own insert against
-- the then-authorized set, and nothing re-validates them. Only FUTURE inserts signed by the
-- revoked key are rejected, because every authorized-set lookup excludes revoked keys. This
-- is the compromise-vs-loss requirement: a stolen key's past signatures stand, its future
-- ones are rejected.
--
-- NOTE: stolen-key race window. Between a key's theft and this revocation committing, the
-- thief can still insert rows (chits, key-adds) signed by the stolen key; anything that
-- commits before the revocation stays valid, anything after is rejected. This window is
-- inherent to a two-party, unilateral-chit ledger under distributed (Optimystic) ordering
-- and is NOT closed here -- backstops are fast revocation, tally close, and the counterparty
-- re-key ceremony (ticket key-counterparty-rekey).
create table PartyKeyRevocation (
    Sid text,
    PublicKey text,         -- key being revoked (must be a registered key of the party)
    RevokedBy text,         -- currently-authorized key performing the revoke
    Signature text,         -- signed by RevokedBy

    primary key (Sid, PublicKey),   -- also blocks double-revocation of the same key
    -- Target must be a registered key of this party. "Not already revoked" is enforced by the
    -- primary key (a second revocation of the same (Sid, PublicKey) is rejected), so this need
    -- only confirm registration. It reads RegisteredKey -- normal adds plus counterparty
    -- adoptions -- not the AuthorizedKey view: the view already excludes the target once this
    -- in-flight revocation row is buffered, and reading RegisteredKey (rather than PartyKey
    -- alone) is what makes an ADOPTED key revocable exactly like a normal add.
    constraint TargetAuthorized check on insert (New.PublicKey in (select RK.PublicKey from RegisteredKey RK where RK.Sid = New.Sid)),
    -- Revoker must be currently authorized. The live view is correct here: for a normal
    -- revoke (revoker <> target) the view still contains the revoker, and a revoked key can
    -- never itself revoke (the view excludes it). A key naming itself as RevokedBy is excluded
    -- by the same in-flight row, so self-revocation is not a supported path -- retire a device
    -- from another surviving device.
    constraint RevokerAuthorized check on insert (New.RevokedBy in (select PublicKey from AuthorizedKey AK where AK.Sid = New.Sid)),
    constraint SignatureValid check on insert (SignatureValid(Digest(Sid, PublicKey, RevokedBy), Signature, RevokedBy)),
    -- Self-lockout guard. The AuthorizedKey view already reflects this in-flight revocation
    -- (plain ref = buffered+committed), so this count is the POST-revoke authorized set; we
    -- require >= 1 key to remain. This is the correct realization of the ticket's "prevent
    -- revoking the last key" -- and it is strictly safer than a pre-revoke `> 1`, because a
    -- batch of revocations that would empty the set within ONE transaction is also visible
    -- here and rejected. A fully-compromised party (all keys stolen) therefore cannot revoke
    -- its way to an empty set; it must first adopt a fresh key via the counterparty ceremony
    -- (key-counterparty-rekey).
    -- NOTE: the last-key guarantee across two CONCURRENT, independent revocation transactions
    -- (device A revokes B's key while device B revokes A's key -- each alone leaves >= 1, together
    -- they empty the set) is NOT provided by this constraint alone. Unlike concurrent PartyKey
    -- adds -- which collide on the (Sid, Revision) primary key -- two revocations of different
    -- keys share no key and do not conflict at the PK. Safety then depends on Optimystic
    -- re-evaluating this deferred CHECK against the latest committed snapshot at each commit
    -- (so the second committer sees the first's revocation and its count drops to 0 -> reject).
    -- If Optimystic instead validates only against a transaction's original read snapshot, both
    -- could commit and lock the party out. Confirm the isolation model when a runner exists; if
    -- it does not re-validate, this needs a stronger guard (e.g. serialize revocations per Sid).
    constraint NotLastKey check on insert ((select count(*) from AuthorizedKey AK where AK.Sid = New.Sid) >= 1),
    constraint InsertOnly check on delete, update (0)
);

-- Counterparty re-key ceremony (ticket key-counterparty-rekey). The ONLY path that introduces a
-- key into a party's authorized set WITHOUT an existing key of that party -- last-resort recovery
-- for a party that lost EVERY authorized key (all cadre nodes gone, or every key stolen), where
-- nothing inside the tally can otherwise sign a new key in. Authority here comes from the human
-- trust between the two parties: the recovering party self-signs the fresh key (proving it
-- controls it) and the COUNTERPARTY attests it with one of its own authorized keys ("yes, this
-- really is you"). Bilateral -- neither side can do it alone.
--
-- Sid is UNCHANGED: this re-keys an EXISTING party, it never mints a new identity, so all history
-- stays valid and the two-party invariant (PartyKey.TwoParties) continues to hold -- SidIsParty
-- forbids adoption for an unknown Sid, and adoption never inserts a PartyKey row, so it cannot add
-- a third party. Once an adopted key is authorized, normal add/revoke resumes from it: the party
-- registers its new devices' keys and revokes the lost/stolen ones (now permitted, because
-- NotLastKey sees the adopted key). Adoption is allowed even when the set is non-empty (serves the
-- all-keys-STOLEN case: an honest party gets a counterparty-blessed fresh key BEFORE revoking the
-- thieves).
--
-- Layering: this is the APP layer and presupposes the recovering cadre is already back in the
-- Sereus strand (it lost strand-membership + cadre-authority keys with its nodes). Ordering is
-- Sereus re-invite (regain strand access) -> this table (regain signing authority); the strand
-- re-admission is a sequencing dependency, not a schema constraint, and is NOT modeled here
-- (see docs/architecture.md "Key recovery").
--
-- NOTE: the counterparty IS the recovery trust root, and its honest attestation is the ONLY thing
-- authenticating the recovering party here. SelfSigValid proves the adopted key is a real keypair
-- whose private-key holder consented -- it does NOT prove WHICH party generated it. A malicious
-- counterparty can therefore unilaterally re-key the other party: it generates (or reuses) a key it
-- controls, self-signs Digest(Sid, PublicKey) with it, and attests with its own authorized key,
-- satisfying every guard alone. This is INHERENT and unpreventable at this layer -- in total loss
-- the recovering party retains NO secret inside the tally, so there is no cryptographic material it
-- could present that the counterparty could not fabricate. OUT OF SCOPE by design; the app must
-- surface counterparty attestation as the trust decision it is.
-- NOTE: Digest(Sid, PublicKey) is not tally-bound (follows PartyKey precedent, not the chit
-- tables' Cid-bound digests). A self-signature is valid for this Sid in any tally the party holds,
-- but confers nothing without THAT tally's counterparty attesting with a locally-authorized key,
-- so cross-tally replay of the self-signature alone grants no authority. If adoption ever needs to
-- bind to one specific tally, add (select Cid from TallyCore) to both digests.
create table PartyKeyAdoption (
    Sid text,                    -- party regaining authority (unchanged identity)
    PublicKey text,              -- new key being adopted
    SelfSignature text,          -- new key signs Digest(Sid, PublicKey): possession proof by the recovering party
    CounterpartyKey text,        -- counterparty's currently-authorized key that attests
    CounterpartySignature text,  -- counterparty signs the same digest

    primary key (Sid, PublicKey),   -- also blocks re-adopting the same key for the same party
    -- No new party: adoption re-keys one of the two existing parties, never bootstraps a Sid.
    -- (A party only comes into existence via a PartyKey genesis row, so PartyKey is the party set.)
    constraint SidIsParty check on insert (New.Sid in (select distinct Sid from PartyKey)),
    -- The attesting key must belong to the OTHER party and be currently authorized (non-revoked).
    -- Reads the live AuthorizedKey view: freshness matters (a stale/revoked counterparty key must
    -- fail), and the `<> New.Sid` filter excludes this very adoption row (whose Sid = New.Sid,
    -- now unioned into the view) from vouching for itself -- no self-attestation is possible.
    constraint CounterpartyIsOther check on insert (New.CounterpartyKey in (select PublicKey from AuthorizedKey AK where AK.Sid <> New.Sid)),
    -- Possession proof: the adopted key signs its own adoption. This is what stops the counterparty
    -- from adopting a key it alone controls.
    constraint SelfSigValid check on insert (SignatureValid(Digest(Sid, PublicKey), SelfSignature, PublicKey)),
    -- Attestation: the counterparty's authorized key signs the same digest.
    constraint CounterpartySigValid check on insert (SignatureValid(Digest(Sid, PublicKey), CounterpartySignature, CounterpartyKey)),
    -- Replay/dup guard: the key must not already be a registered add (PartyKey) for this party, and
    -- this must be the sole adoption row for it (plain ref includes the buffered new row -> 1).
    constraint UniqueKey check on insert (
        (select count(*) from PartyKey PK where PK.Sid = New.Sid and PK.PublicKey = New.PublicKey) = 0
        and (select count(*) from PartyKeyAdoption A where A.Sid = New.Sid and A.PublicKey = New.PublicKey) = 1
    ),
    constraint InsertOnly check on delete, update (0)
);

-- Every key ever introduced for a party, revocation-agnostic: normal adds (PartyKey) plus
-- counterparty-attested adoptions (PartyKeyAdoption, the key-counterparty-rekey ceremony).
-- AuthorizedKey subtracts revocations from this; PartyKeyRevocation.TargetAuthorized reads THIS
-- view (not the authorized one) so a key stays a recognizable revocation target even after the
-- in-flight revocation buffers -- and, crucially, so an ADOPTED key is revocable exactly like a
-- normal add. Factored into its own view so the PartyKey-union-PartyKeyAdoption set is defined
-- once, not duplicated across every consumer. (union, not union all: the two sources never share a
-- (Sid, PublicKey) -- PartyKeyAdoption.UniqueKey forbids adopting a key already registered in
-- PartyKey -- so dedup is a safety net, not load-bearing.)
create view RegisteredKey as
    select Sid, PublicKey from PartyKey
    union
    select Sid, PublicKey from PartyKeyAdoption;

-- The party's currently-authorized signing keys: every registered key (RegisteredKey = adds plus
-- adoptions) minus revoked ones. Signature-gated tables resolve their SignerKey against this set.
-- Reads current (buffered+committed) state; constraints that must exclude the row being inserted
-- (PartyKey.RevisionMonotonicInt, PartyKey.AuthKeyAuthorized) use committed.* directly instead of
-- this view.
-- NOTE: every SignerAuthorized / RevokerAuthorized / NotLastKey / CounterpartyIsOther check
-- references THIS view (or RegisteredKey) from inside a CHECK sub-query. Confirmed against Quereus
-- source (planner/building/select.ts buildFrom inlines a view wherever a base table is accepted,
-- including constraint sub-queries, with no base-table-only guard) -- but Quereus has NO test
-- exercising a view inside a CHECK. If a future runner rejects a view here, the fallback is to
-- inline the body -- RegisteredKey (PartyKey union PartyKeyAdoption) minus PartyKeyRevocation --
-- directly into each referencing constraint.
-- NOTE: NEW here vs the sibling key-multi-and-revoke ticket -- PartyKeyAdoption.CounterpartyIsOther
-- references AuthorizedKey, while AuthorizedKey (via RegisteredKey) references PartyKeyAdoption: a
-- table<->view definitional CYCLE. It is unbreakable by reordering (each side names the other), so
-- the table is created before these views and relies on Quereus resolving view names at
-- statement-build time, not DDL-creation order. The committed.* forward table references already in
-- this schema resolve the same way; a view forward-reference is the same class, unexercised by any
-- runner.
create view AuthorizedKey as
    select RK.Sid, RK.PublicKey
    from RegisteredKey RK
    where not exists (select 1 from PartyKeyRevocation R where R.Sid = RK.Sid and R.PublicKey = RK.PublicKey);

-- Tally identity record (feat-schema-tally-core). The founding facts of the tally, whose digest IS the
-- tally CID -- the per-strand anchor every Cid-bound signature (contracts, chits, pledges) binds to, so a
-- row signed for this tally can never be replayed into another. Single row, insert-only, created once at
-- formation. Created AFTER seating (both Stock and Foil rows exist) and BEFORE negotiation: no Cid-bound
-- table is written until negotiation, and the seating tables (Stock/Foil/PartyKey/PartyCertificate)
-- deliberately do NOT bind to Cid, so the invitee's Sid is already known when this row is needed. Folding
-- FoilSid into the Cid makes the identity commit to BOTH parties -- see the replay NOTE.
--
-- Cid = Digest(StockSid, FoilSid, ProtocolVersion, CreatedAt). The stored Cid must equal that digest
-- (CidCorrect); StockSid/FoilSid must be the actually-seated parties (StockSeated/FoilSeated pin them to
-- the single-row Stock/Foil tables), so even a malicious initiator cannot name a counterparty who never
-- seated. Signed by an authorized key of the STOCK (initiator) party -- "created by the initiator".
--
-- NOTE (replay): both party Sids are folded into the Cid, so the tally identity cryptographically commits
-- to WHICH two parties it binds. A chit/contract/pledge digest binding this Cid cannot validate in any
-- tally with a different party pair. Excluding FoilSid (the provision-time alternative) would commit only
-- to the initiator + timestamp, weakening cross-tally replay protection -- rejected.
-- NOTE (CreatedAt trust): CreatedAt is chosen by the inserting (stock) party. A dishonest value only
-- changes the Cid, which both parties observe before binding any negotiation signature to it -- disputable,
-- not silently exploitable. Not gated against now() (that would make the insert volatile/non-deterministic,
-- same reasoning as CreditTerms.Date at schema/draft1.qsql:486-495).
-- NOTE: StockSeated/FoilSeated pin each Sid independently; a self-tally (StockSid = FoilSid) is not
-- rejected here. Fine now -- honest two-party seating cannot produce it (Foil requires the invitee to
-- sign with Stock's out-of-band invitation secret). If a formation path ever lets one party hold both
-- roles, add a StockSid <> FoilSid check here (PerspectiveBalance et al. union the two Sids and would
-- collapse to one party).
create table TallyCore (
    Cid text,              -- tally id: digest of the founding fields below; the per-strand signature anchor
    StockSid text,         -- initiator (stock) party identity
    FoilSid text,          -- invitee (foil) party identity
    ProtocolVersion text,  -- Taleus tally protocol version in force at formation
    CreatedAt text,        -- formation timestamp
    SignerKey text,        -- authorized PartyKey of StockSid that signed this row
    Signature text,

    primary key (/* 1 row */),
    -- Cid is the content address of the founding fields: the stored value must equal their digest.
    constraint CidCorrect check on insert (New.Cid = Digest(StockSid, FoilSid, ProtocolVersion, CreatedAt)),
    -- StockSid/FoilSid must name the actually-seated parties (both tables are single-row), so the identity
    -- cannot be minted against a counterparty who never seated. Requiring the Foil row also pins creation
    -- to AFTER the invitee seats.
    constraint StockSeated check on insert (New.StockSid in (select Sid from Stock)),
    constraint FoilSeated check on insert (New.FoilSid in (select Sid from Foil)),
    constraint ProtocolVersionPresent check on insert (New.ProtocolVersion is not null and New.ProtocolVersion <> ''),
    constraint CreatedAtValid check on insert (ValidDate(New.CreatedAt)),
    -- Initiator (stock) creates the identity: SignerKey resolves against the STOCK party's authorized set.
    constraint SignerAuthorized check on insert (New.SignerKey in (select PublicKey from AuthorizedKey AK where AK.Sid = New.StockSid)),
    constraint SignatureValid check on insert (SignatureValid(
        Digest(StockSid, FoilSid, ProtocolVersion, CreatedAt),
        Signature,
        New.SignerKey
    )),
    constraint InsertOnly check on delete, update (0)
);

create table PartyCertificate (
    PartySid text,
    Revision integer,
    Certificate text,
    SignerKey text,        -- authorized PartyKey of PartySid that signed this revision
    Signature text,

    primary key (PartySid, Revision),
    constraint RevisionMonotonicInt check on insert (Revision = Coalesce((select max(Revision) from PartyCertificate PC where PC.PartySid = New.PartySid), 0) + 1),
    constraint SignerAuthorized check on insert (New.SignerKey in (select PublicKey from AuthorizedKey AK where AK.Sid = New.PartySid)),
    constraint SignatureValid check on insert (SignatureValid(
        Digest(PartySid, Revision, Certificate),
        Signature,
        New.SignerKey
    )),
    constraint InsertOnly check on delete, update (0)
);

-- ValidDenomination(id): prefix-dispatch validity check for a tally's denomination identifier
-- (feat-denomination-argument). A host-registered scalar like ValidDate/SignatureValid/Digest --
-- referenced here, defined by the runner. NO general parser and NO currency-table lookup: three
-- namespaces, each dispatched by prefix, and that is the whole contract:
--   `CHIP`             -- the network reference unit; the reserved bare token, no prefix.
--   `iso4217:<AAA>`    -- national currency; <AAA> is exactly three UPPERCASE ASCII letters
--                         (an ISO 4217 code). NOT validated against a currency table -- shape only,
--                         so a future/private code passes; `iso4217:US`, `iso4217:usd`, `iso4217:USDX`
--                         all fail on the three-uppercase-letter shape.
--   `cid:<address>`    -- custom / open-ended unit, identified by the content address (CID) of a
--                         denomination-descriptor document. The address must be NON-EMPTY (`cid:`
--                         alone fails). Content-addressing makes the identifier globally unique by
--                         construction: two parties referencing the same descriptor reference the same
--                         CID, and two different descriptors cannot collide.
-- Custom-unit meaning is confirmed at NEGOTIATION time (both parties fetch the descriptor by CID and
-- agree it names the same unit), NOT here -- do not add a runtime CHECK that fetches a CID. The
-- descriptor is minimal: { name, symbol, description, canonicalUnit }; its human-readable label is
-- display-only, so label collisions are harmless. See docs/architecture.md "Denomination registry".
create table TallyContractProposal (
    SequenceNumber integer,
    ContractCid text,
    Proposer text check (Proposer in ('S', 'F')),
    -- Terms revisions this proposal expects the accepted contract to lock (folded into Signature).
    -- Load-bearing coverage is on TallyContract; the proposal carries them for a complete offer.
    StockCreditTermsRevision integer,
    FoilCreditTermsRevision integer,
    -- Denomination argument. The proposal carries it (validated, folded into Signature) so the offer
    -- is complete and a malformed identifier is rejected at PROPOSAL time as well as at acceptance.
    -- The load-bearing bilateral-signature coverage + life-of-tally immutability live on TallyContract.
    -- Defaults to CHIP at scale 0 -- an offer that omits the argument reproduces today's implicit
    -- single-denomination behavior with no ceremony.
    Denomination text default 'CHIP' check (ValidDenomination(Denomination)),
    DenominationScale integer default 0 check (DenominationScale >= 0),
    SignerKey text,        -- authorized PartyKey of the proposing party that signed
    Signature text,

    primary key (/* 1 row */),
    -- SignerKey resolves against the proposing side's own authorized set. This also fixes the
    -- draft placeholder that passed ProposerSid (a party id) as the public-key argument.
    constraint SignerAuthorized check on insert, update (New.SignerKey in (
        select PublicKey from AuthorizedKey AK
        where AK.Sid = (select case when New.Proposer = 'S' then StockSid else FoilSid end from TallyCore)
    )),
    constraint SignatureValid check on insert, update (SignatureValid(
        Digest((select Cid from TallyCore), SequenceNumber, ContractCid, Proposer, StockCreditTermsRevision, FoilCreditTermsRevision, Denomination, DenominationScale),
        Signature,
        New.SignerKey
    ))
);


create table TallyContract (
    Number integer,
    ContractCid text,
    -- Credit terms (limit, call) are UNILATERAL per-party policy in CreditTerms; the bilaterally
    -- signed contract covers the terms-in-force at acceptance BY REFERENCE -- each party names its
    -- operative CreditTerms revision here, folded into both signatures. Because CreditTerms rows are
    -- insert-only and grantor-signed, referencing (Sid, Revision) transitively covers their content.
    -- Later unilateral revisions do NOT touch the contract. (The bilateral denomination argument, by
    -- contrast, attaches as its OWN columns below -- Denomination/DenominationScale -- because it is a
    -- single shared value BOTH parties sign, not a per-party reference.)
    StockCreditTermsRevision integer,
    FoilCreditTermsRevision integer,
    -- Denomination argument (feat-denomination-argument): the tally's unit of account + scale. A
    -- SINGLE shared value covered by BOTH signatures below -- one denomination binds stock and foil
    -- alike; it is never a per-party (unilaterally-signed) row, unlike credit terms. Fixed for the
    -- tally's life -- DenominationImmutable ties every later revision to revision 1; renegotiation may
    -- change credit terms but never the unit. Scale is a decimal exponent >= 0: one Ledger.Units
    -- integer = 10^(-DenominationScale) of the denomination's display unit (iso4217:USD scale 2 ->
    -- Units are cents; CHIP scale 3 -> milliCHIPs). The contract's stated scale is authoritative; for
    -- iso4217 it is NOT cross-checked against a currency table. Defaults to CHIP at scale 0 -- a tally
    -- created with no denomination argument behaves exactly as today (Ledger math is scale-independent,
    -- so the default is a true regression). ValidDenomination rejects malformed identifiers.
    Denomination text default 'CHIP' check (ValidDenomination(Denomination)),
    DenominationScale integer default 0 check (DenominationScale >= 0),
    StockSignerKey text,   -- authorized PartyKey of StockSid that signed StockSignature
    StockSignature text,
    FoilSignerKey text,    -- authorized PartyKey of FoilSid that signed FoilSignature
    FoilSignature text,

    primary key (Number),
    -- Each named terms revision must exist for its grantor.
    constraint StockTermsExist check on insert, update (New.StockCreditTermsRevision in (select Revision from CreditTerms CT where CT.Sid = StockSid)),
    constraint FoilTermsExist  check on insert, update (New.FoilCreditTermsRevision  in (select Revision from CreditTerms CT where CT.Sid = FoilSid)),
    -- Each side's SignerKey resolves against ITS OWN party's authorized set, independently.
    constraint StockSignerAuthorized check on insert, update (New.StockSignerKey in (select PublicKey from AuthorizedKey AK where AK.Sid = StockSid)),
    constraint StockSignatureValid check on insert, update (SignatureValid(
        Digest((select Cid from TallyCore), Number, ContractCid, StockCreditTermsRevision, FoilCreditTermsRevision, Denomination, DenominationScale),
        StockSignature,
        New.StockSignerKey
    )),
    constraint FoilSignerAuthorized check on insert, update (New.FoilSignerKey in (select PublicKey from AuthorizedKey AK where AK.Sid = FoilSid)),
    constraint FoilSignatureValid check on insert, update (SignatureValid(
        Digest((select Cid from TallyCore), Number, ContractCid, StockCreditTermsRevision, FoilCreditTermsRevision, Denomination, DenominationScale),
        FoilSignature,
        New.FoilSignerKey
    )),
    -- Denomination + scale are FIXED for the tally's life: every revision after the first must match
    -- revision 1's, so a revision-2 contract naming a different denomination or scale is rejected.
    -- Reads `Number = 1` directly -- the filter excludes the row being inserted (whose Number > 1), so
    -- the plain and committed.* views coincide here (a later revision is never inserted in the same
    -- transaction as revision 1). Ties immutability to revision 1 (not the immediately-prior revision)
    -- so the whole chain is anchored to the first accepted contract, per feat-denomination-argument.
    -- The `exists` guard is LOAD-BEARING: a Quereus CHECK passes when its expression is NULL (only a
    -- definite FALSE rejects -- see quereus runtime/emit/constraint-check.ts). Without the guard, if
    -- revision 1 is absent (TallyContract has no Number-monotonicity, so a first insert at Number > 1
    -- is possible) the `= (empty subquery)` comparisons are NULL, the whole expression is NULL, and the
    -- constraint would ACCEPT an unanchored later revision with an arbitrary denomination -- silently
    -- defeating the lock. The guard forces a definite FALSE (reject) whenever revision 1 does not exist.
    constraint DenominationImmutable check on insert (
        New.Number = 1
        or (exists (select 1 from TallyContract where Number = 1)
            and New.Denomination = (select Denomination from TallyContract where Number = 1)
            and New.DenominationScale = (select DenominationScale from TallyContract where Number = 1))
    ),
    constraint InsertOnly check on delete, update (0)
);

-- Trading variables: each party's published lift policy for this tally, revisioned.
-- Semantics follow MyCHIPs (mychips/schema/tallies.wmt), expressed from the issuing
-- party's perspective (positive = value this party has accumulated on the tally):
--   Target: ideal balance to accumulate via lifts; lifts may raise the balance to Target free of charge
--   Bound:  maximum balance the party is willing to accrue through lifts
--   Reward: cost ratio charged for lift value accumulated above Target, up to Bound
--   Clutch: cost ratio charged for drops (lifts that reduce the balance this party has accumulated)
-- Ratios are parts per million (10000 = 1%); positive is a fee, negative a subsidy.
-- Clutch = 1000000 effectively blocks drops.
create table TradingVariable (
    Sid text,
    Revision integer,
    Target integer default 0 check (Target >= 0),
    Bound integer default 0 check (Bound >= Target),
    Reward integer default 0,   -- ppm
    Clutch integer default 0,   -- ppm
    SignerKey text,        -- authorized PartyKey of Sid that signed this revision
    Signature text,

    primary key (Sid, Revision),
    constraint PartyOfTally check on insert (Sid in (select StockSid from TallyCore union select FoilSid from TallyCore)),
    constraint RevisionMonotonicInt check on insert (Revision = Coalesce((select max(Revision) from TradingVariable TV where TV.Sid = New.Sid), 0) + 1),
    constraint SignerAuthorized check on insert (New.SignerKey in (select PublicKey from AuthorizedKey AK where AK.Sid = New.Sid)),
    constraint SignatureValid check on insert (SignatureValid(
        Digest((select Cid from TallyCore), Sid, Revision, Target, Bound, Reward, Clutch),
        Signature,
        New.SignerKey
    )),
    constraint InsertOnly check on delete, update (0)
);

-- Credit one party (Sid = grantor) extends to the counterparty. UNILATERAL: only the grantor
-- signs. Same shape as TradingVariable (per-Sid, revisioned, insert-only, grantor-signed) --
-- it is the same kind of published unilateral policy. Semantics (docs/old/tally.md):
--   CreditLimit: max the grantor lets the counterparty owe it -> caps how far the grantor's
--                PERSPECTIVE balance may rise in its favor.
--   CallDays:    days of notice the grantor must give before a RESTRICTIVE change takes effect.
--   Args:        optional JSON for contract-specific credit parameters; null = none (generic
--                extension point for "additional terms").
--   EffectiveDate: when this revision governs. Revision 1 and permissive changes == Date
--                (immediate); restrictive changes >= Date + prior revision's CallDays.
-- NOTE: backdated-Date trust caveat. A grantor could set Date in the past to shorten the
-- real-world notice it owes before a restrictive change bites. This is inherent to a
-- unilateral, grantor-signed timestamp -- both parties replicate this strand and observe the
-- signed Date, so a backdate is disputable, not silently exploitable. Not solved
-- cryptographically here; if a bound is later wanted, gate Date against date('now') -- but that
-- makes the insert volatile (non-deterministic), so it is deliberately left off.
create table CreditTerms (
    Sid text,               -- grantor (party extending credit)
    Revision integer,
    CreditLimit integer default 0 check (CreditLimit >= 0),  -- CreditLimit not Limit (reserved word)
    CallDays integer default 0 check (CallDays >= 0),
    Args text,              -- optional JSON, contract-specific params
    Date text check (ValidDate(Date)),                    -- grantor-signed issuance timestamp
    EffectiveDate text check (ValidDate(EffectiveDate)),
    SignerKey text,         -- authorized PartyKey of Sid that signed this revision
    Signature text,

    primary key (Sid, Revision),
    constraint PartyOfTally check on insert (Sid in (select StockSid from TallyCore union select FoilSid from TallyCore)),
    -- NOTE: committed.* vs plain ref. This table reads committed.CreditTerms for the monotonic and
    -- prior-revision lookups, following PartyKey's carefully-reasoned rule (schema/draft1.qsql:54-59):
    -- committed.* excludes the row being inserted so `Revision = max + 1` is satisfiable. The sibling
    -- unilateral-revisioned tables TradingVariable (RevisionMonotonicInt) and PartyCertificate use a
    -- PLAIN ref for the same monotonic check -- an apparent inconsistency in the existing schema.
    -- Confirm the correct choice against the Quereus deferral model when a runner exists; do NOT
    -- "fix" the siblings inside this ticket (tripwire, not a task).
    constraint RevisionMonotonicInt check on insert (Revision = Coalesce((select max(Revision) from committed.CreditTerms CT where CT.Sid = New.Sid), 0) + 1),
    constraint SignerAuthorized check on insert (New.SignerKey in (select PublicKey from AuthorizedKey AK where AK.Sid = New.Sid)),
    constraint SignatureValid check on insert (SignatureValid(
        Digest((select Cid from TallyCore), Sid, Revision, CreditLimit, CallDays, Args, Date, EffectiveDate),
        Signature,
        New.SignerKey
    )),
    -- Notice rule. Prior = immediately preceding revision for this grantor (committed).
    --   Revision 1 (no prior): effective immediately.
    --   Permissive (CreditLimit non-decreasing AND CallDays non-decreasing): immediate.
    --   Restrictive (CreditLimit decreases OR CallDays decreases): grantor owes the counterparty
    --   the PRIOR revision's CallDays of notice -> EffectiveDate >= Date + prior.CallDays.
    -- Shortening CallDays is itself restrictive: otherwise a grantor could instantly shorten notice,
    -- then yank the limit. A revision that raises CreditLimit but shortens CallDays is restrictive.
    constraint EffectiveDateValid check on insert (
        (New.Revision = 1 and julianday(New.EffectiveDate) = julianday(New.Date))
        or (New.Revision > 1 and
            case
                when New.CreditLimit >= (select CreditLimit from committed.CreditTerms CT where CT.Sid = New.Sid and CT.Revision = New.Revision - 1)
                 and New.CallDays   >= (select CallDays   from committed.CreditTerms CT where CT.Sid = New.Sid and CT.Revision = New.Revision - 1)
                then julianday(New.EffectiveDate) = julianday(New.Date)
                else julianday(New.EffectiveDate) >= julianday(New.Date)
                     + (select CallDays from committed.CreditTerms CT where CT.Sid = New.Sid and CT.Revision = New.Revision - 1)
            end)
    ),
    constraint InsertOnly check on delete, update (0)
);

-- Signed close request (feat-schema-tally-close): either party may sign one row to move the tally to
-- Closing. Unilateral by design AND safe -- Closing does only two things: it FREEZES balance growth (no
-- new chit from either side may move the settled balance away from zero -- no new credit either direction,
-- a right each party already holds by setting CreditTerms.CreditLimit to the current balance) and it always
-- PERMITS balance-reducing activity (direct chits AND lift pledges), so whoever holds a positive balance can
-- always be paid down or lift its value out. A close therefore never traps the counterparty: Closed is
-- reached only when the settled balance is ACTUALLY zero (CloseState). Setting CreditTerms.CreditLimit = 0 is
-- NOT a close: close is its own separately-signed table, so zero credit leaves the tally Open (CloseState =
-- 'open', balance still payable, credit restorable by a later CreditTerms revision). Mirrors the Invoice /
-- InvoiceDecline signer pattern: SignerKey resolves against the requesting side's own AuthorizedKey set, and
-- the Cid-bound digest stops a close request being replayed into another tally. See docs/architecture.md
-- "Tally close".
-- NOTE: no reopen/withdraw path; if wind-down needs to be reversible, add a signed CloseWithdrawal that
-- supersedes -- see backlog if it comes up.
create table CloseRequest (
    Requester text check (Requester in ('S','F')),  -- party requesting closure
    Date text check (ValidDate(Date)),
    SignerKey text,        -- authorized PartyKey of the requesting party
    Signature text,        -- requester signs Digest(Cid, Requester, Date)

    primary key (Requester),   -- at most one close request per party; either or both may file
    constraint SignerAuthorized check on insert (New.SignerKey in (
        select PublicKey from AuthorizedKey AK
        where AK.Sid = (select case when New.Requester = 'S' then StockSid else FoilSid end from TallyCore)
    )),
    constraint SignatureValid check on insert (SignatureValid(
        Digest((select Cid from TallyCore), Requester, Date),
        Signature, New.SignerKey
    )),
    constraint InsertOnly check on delete, update (0)
);

-- Effective (latest-revision) trading variables per party.
-- A party that has published none trades at the MyCHIPs defaults (all zero):
-- lifts may pay its accumulated balance down to zero for free, and accumulate nothing beyond that.
create view CurrentTradingVariable as
    select P.Sid,
        coalesce(TV.Target, 0) as Target,
        coalesce(TV.Bound, 0) as Bound,
        coalesce(TV.Reward, 0) as Reward,
        coalesce(TV.Clutch, 0) as Clutch
    from (select StockSid as Sid from TallyCore union select FoilSid as Sid from TallyCore) P
        left join TradingVariable TV on TV.Sid = P.Sid
            and TV.Revision = (select max(Revision) from TradingVariable T2 where T2.Sid = P.Sid);

-- Effective (latest-effective-revision) credit limit each party grants, as of now.
-- Advisory only -- fuels LiftLading capacity advertisement; the hard safety gate is the
-- deterministic, chit-dated Ledger.WithinCreditLimits below. Effective limit = CreditLimit of
-- the highest-Revision CreditTerms row whose EffectiveDate <= now; absent any row -> 0.
-- NOTE: julianday('now')/date('now') are VOLATILE -- fine in a plain view; NOT allowed in a
-- MATERIALIZED view (Quereus hard-rejects volatile there). If a future runner rejects
-- volatile-in-view, fall back to computing the effective revision in the lift agent
-- (application) and keep the deterministic chit-dated Ledger gate as the safety boundary.
create view CurrentCreditLimit as
    select P.Sid,
        coalesce((select CT.CreditLimit from CreditTerms CT
                  where CT.Sid = P.Sid and julianday(CT.EffectiveDate) <= julianday('now')
                  order by CT.Revision desc limit 1), 0) as CreditLimit
    from (select StockSid as Sid from TallyCore union select FoilSid as Sid from TallyCore) P;

-- Tally balance from each party's perspective (positive = value that party has accumulated), SETTLED
-- only: direct chits + FINALIZED lifts -- the Ledger.Balance chain. This is the authoritative signed
-- balance and stays the value reports/PerspectiveBalance consumers read.
-- Ledger convention: foil-issued chits increment Balance, so raw Balance is already
-- the stock holder's perspective; the foil holder sees its negation.
-- Pending (unresolved) lift chits are deliberately NOT folded in here: a pledge reserves capacity via
-- the separate ReservedBalance / ReservedPerspectiveBalance views (below) and only enters this settled
-- chain when it FINALIZES. LiftLading advertises free capacity from the RESERVED views, so open pending
-- lifts shrink advertised capacity without moving the signed balance -- this realizes the former "fold in
-- pending lift chits" plan item (the pending-aware view is ReservedPerspectiveBalance, not this one). Open
-- invoices are likewise advisory-only (OpenInvoice), not folded into this Balance or the hard credit gate.
create view PerspectiveBalance as
    select P.Sid,
        coalesce((select Balance from Ledger order by Number desc limit 1), 0)
            * (case when P.Sid = (select StockSid from TallyCore) then 1 else -1 end) as Balance
    from (select StockSid as Sid from TallyCore union select FoilSid as Sid from TallyCore) P;

-- Open (unresolved) pending lifts: a PendingLift row with NEITHER a Ledger finalize (Kind='lift') NOR a
-- LiftVoid for its LiftId. This is the reservation set -- ReservedBalance sums it. A finalize or a void
-- drops the row out immediately (its capacity moves to the settled chain, or is released), so the reserved
-- gate counts open pledges only.
create view OpenPendingLift as
    select PL.LiftId, PL.RefereeKey, PL.Issuer, PL.Units, PL.Date, PL.Expiry, PL.SignerKey, PL.Signature
    from PendingLift PL
    where not exists (select 1 from Ledger L where L.LiftId = PL.LiftId and L.Kind = 'lift')
      and not exists (select 1 from LiftVoid V where V.LiftId = PL.LiftId);

-- Derived close lifecycle (feat-schema-tally-close): open / closing / closed, one row (TallyCore is one row).
--   'open'    -- no CloseRequest row filed. Does NOT distinguish Forming / Open / Void: those depend on
--                contract/formation state the schema does not materialize today (out of scope).
--   'closing' -- a CloseRequest row exists but the tally is not yet a stable zero.
--   'closed'  -- terminal, stable: the SETTLED balance (raw Ledger.Balance, latest row) is zero AND no
--                pending lift is still open. The open-pledge test is load-bearing -- without it a still-open
--                pledge could later finalize and bump a "closed" tally back off zero, so 'closed' would not
--                be stable. Reads settled Ledger.Balance (not reserved) so a finalize can never unsettle it.
create view CloseState as
    select case
        when not exists (select 1 from CloseRequest) then 'open'
        when coalesce((select Balance from Ledger order by Number desc limit 1), 0) = 0
             and not exists (select 1 from OpenPendingLift) then 'closed'
        else 'closing'
    end as State
    from TallyCore;   -- single row

-- Reserved balance = settled signed balance + every OPEN pending-lift delta, stock-perspective (same sign
-- convention as raw Ledger.Balance: foil-issued +Units, stock-issued -Units, matching BalanceCorrect).
-- Single row (TallyCore is one row). New PendingLift pledges and new direct chits gate against THIS via
-- WithinReservedCredit so concurrent lifts cannot collectively over-commit; LiftLading advertises net of it.
-- Because the gate reads this with a plain (buffered+committed) ref, the row being inserted is already
-- reflected -- see WithinReservedCredit on PendingLift and Ledger.
create view ReservedBalance as
    select
        coalesce((select Balance from Ledger order by Number desc limit 1), 0)
        + coalesce((select sum(Units * case when Issuer = 'F' then 1 else -1 end) from OpenPendingLift), 0)
            as Balance
    from TallyCore;

-- Per-party reserved balance -- mirrors PerspectiveBalance but off ReservedBalance (settled + open
-- pending), negated for the foil side. LiftLading advertises from this; PerspectiveBalance stays SETTLED.
create view ReservedPerspectiveBalance as
    select P.Sid,
        (select Balance from ReservedBalance)
            * (case when P.Sid = (select StockSid from TallyCore) then 1 else -1 end) as Balance
    from (select StockSid as Sid from TallyCore union select FoilSid as Sid from TallyCore) P;

-- Lift lading: what a lift may move through this tally, per direction.
-- A direction is named by its receiver -- the party whose perspective balance rises;
-- the counterparty releases the same value (perspective balances are negatives of each
-- other). One row per party; a drop is the same movement read from the other row.
--   FreeUnits:     receiver accumulation up to its Target -- no reward fee
--   RewardedUnits: further accumulation up to its Bound, charged at the receiver's Reward
--   Reward/Clutch: per-unit fee ratios (ppm); Clutch is the releasing counterparty's
--                  charge and applies to the whole moved amount
-- Fee ratios compose along a lift route as NewRate = PriorRate + MyRate * (1 - PriorRate).
-- Receiver accumulation is additionally capped by the credit the RECEIVER granted the
-- counterparty: a lift raises the receiver's perspective balance (the counterparty's debt to
-- the receiver), bounded by CurrentCreditLimit. Cap = min(Bound, receiver's effective
-- CreditLimit); Balance + moved <= Cap. Advisory only -- the hard safety gate is the
-- deterministic, chit-dated Ledger.WithinCreditLimits / WithinReservedCredit.
-- Balance here is the RESERVED perspective balance (settled + open pending lifts), so an open pledge
-- already subtracts from advertised free capacity -- concurrent lifts do not double-advertise the same room.
-- NOTE (pre-existing, unrelated to lift chits): the FreeUnits/RewardedUnits math below uses SCALAR 2-arg
-- max()/min(), which Quereus does not provide (it has aggregate min/max only, so this view fails to bind:
-- "Function not found: max/2"). Predates this ticket; tracked in backlog/debt-schema-liftlading-scalar-minmax
-- (rewrite as CASE expressions, or add scalar min/max upstream). Everything else in the lift-chit machinery
-- binds cleanly on Quereus -- this is the sole exception.
create view LiftLading as
    select
        RV.Sid as ReceiverSid,
        max(0, min(RV.Target, min(RV.Bound, CCL.CreditLimit)) - PB.Balance) as FreeUnits,
        max(0, min(RV.Bound, CCL.CreditLimit) - max(PB.Balance, RV.Target)) as RewardedUnits,
        RV.Reward,
        CV.Clutch
    from CurrentTradingVariable RV
        join ReservedPerspectiveBalance PB on PB.Sid = RV.Sid
        join CurrentCreditLimit CCL on CCL.Sid = RV.Sid
        join CurrentTradingVariable CV on CV.Sid <> RV.Sid;

-- Invoice state, derived from the tables (never stored). Precedence paid > declined > expired > open.
-- 'paid' is checked first, so the derived state stays deterministic even if a decline and a chit both
-- somehow commit (self-inflicted -- both are the payer's own actions; see InvoiceLink / InvoiceDecline).
-- 'expired' is time-derived (julianday('now') is VOLATILE -- fine in a plain view, NOT allowed in a
-- MATERIALIZED view; same caveat as CurrentCreditLimit at schema/draft1.qsql:504). It is deliberately
-- NOT gated at chit insert -- a late payment still succeeds and 'paid' wins by precedence.
create view InvoiceState as
    select I.Id, I.Requester, I.Units, I.Date, I.ExpiryDate,
        case
            when exists (select 1 from Ledger L where L.InvoiceId = I.Id) then 'paid'
            when exists (select 1 from InvoiceDecline D where D.InvoiceId = I.Id) then 'declined'
            when I.ExpiryDate is not null and julianday(I.ExpiryDate) < julianday('now') then 'expired'
            else 'open'
        end as State
    from Invoice I;

-- Open (unanswered, undeclined, unexpired) invoices -- advisory signal of upcoming balance movement
-- for the lift agent / credit-check application layer. NOT folded into LiftLading or WithinCreditLimits.
create view OpenInvoice as
    select Id, Requester, Units, Date, ExpiryDate from InvoiceState where State = 'open';

-- Payment request. One party formally asks the counterparty to pay it: the Requester is the party that
-- wants to RECEIVE value (the future chit recipient), so the answering chit's Issuer is always the
-- OPPOSITE side (see Ledger.InvoiceLink and the BalanceCorrect convention). Signed by the requester;
-- insert-only, Cid-bound digest, no mutable state. An invoice is a REQUEST, not a commitment: it is
-- NOT gated against credit limits at insert (requesting more than current capacity is legitimate -- the
-- payer may raise credit first), and its expiry is time-derived and advisory (see InvoiceState), so the
-- insert stays deterministic/non-volatile. State (open/declined/expired/paid) is DERIVED, never stored.
create table Invoice (
    Id text default RandomUUID(),
    Requester text check (Requester in ('S', 'F')),  -- party requesting payment (future recipient)
    Units integer check (Units > 0),                 -- smallest denomination unit, exact-match by the answering chit
    Date text check (ValidDate(Date)),
    ExpiryDate text null,                           -- null = never expires
    Reference text,                                 -- machine-readable JSON (stored as text, no parser -- house rule)
    Memo text,
    SignerKey text,                                 -- authorized PartyKey of the requesting party
    Signature text,

    primary key (Id),
    -- SignerKey resolves against the REQUESTING side's own authorized set.
    constraint SignerAuthorized check on insert (New.SignerKey in (
        select PublicKey from AuthorizedKey AK
        where AK.Sid = (select case when New.Requester = 'S' then StockSid else FoilSid end from TallyCore)
    )),
    constraint SignatureValid check on insert (SignatureValid(
        Digest((select Cid from TallyCore), Id, Requester, Units, Date, ExpiryDate, Reference, Memo),
        Signature, New.SignerKey
    )),
    -- ExpiryDate, when present, must be a valid date at or after Date.
    constraint ExpiryValid check on insert (
        New.ExpiryDate is null
        or (ValidDate(New.ExpiryDate) and julianday(New.ExpiryDate) >= julianday(New.Date))
    ),
    constraint InsertOnly check on delete, update (0)
);

-- A signed decline of an invoice by the PAYER (the counterparty of the requester). Expiry needs no row
-- (it is time-derived); a decline is an explicit act and so needs a signed record. At most one per
-- invoice, and only before the invoice is answered by a chit.
create table InvoiceDecline (
    InvoiceId text,
    DeclinedBy text check (DeclinedBy in ('S', 'F')),  -- must be the payer (counterparty of requester)
    SignerKey text,
    Signature text,

    primary key (InvoiceId),                         -- at most one decline per invoice
    constraint InvoiceExists check on insert (New.InvoiceId in (select Id from Invoice)),
    -- Only the payer may decline: DeclinedBy is the side that is NOT the requester.
    constraint DeclinerIsPayer check on insert (
        New.DeclinedBy <> (select Requester from Invoice where Id = New.InvoiceId)
    ),
    constraint SignerAuthorized check on insert (New.SignerKey in (
        select PublicKey from AuthorizedKey AK
        where AK.Sid = (select case when New.DeclinedBy = 'S' then StockSid else FoilSid end from TallyCore)
    )),
    constraint SignatureValid check on insert (SignatureValid(
        Digest((select Cid from TallyCore), InvoiceId, DeclinedBy),
        Signature, New.SignerKey
    )),
    -- Cannot decline an invoice already answered by a chit. Mirror of Ledger.InvoiceLink's
    -- not-declined guard; both are commit-time subqueries with the SAME isolation caveat noted there.
    constraint NotPaid check on insert (not exists (select 1 from Ledger L where L.InvoiceId = New.InvoiceId)),
    constraint InsertOnly check on delete, update (0)
);

create table Ledger (
    Number integer, -- Sequential, monotonically increasing
    ContractNumber integer,
    Id text default RandomUUID(),
    Issuer text check (Issuer in ('S', 'F')), -- S = Stock, F = Foil
    Units integer check (Units > 0),
    Date text check (ValidDate(Date)),
    Reference text, -- JSON object
    Memo text,
    InvoiceId text null,   -- set when this chit answers an invoice (see InvoiceLink)
    SignerKey text,        -- authorized PartyKey of the issuing party (Kind='direct' only; null for a finalize)
    Signature text,        -- issuer chit signature (Kind='direct' only; null for a finalize)
    Balance integer,
    -- Lift chits (feat-schema-lift-chits). A direct chit is issuer-signed; a lift chit is a FINALIZE of a
    -- PendingLift pledge, authorized by the referee's commit signature + the pre-signed pledge (no fresh
    -- issuer signature). See KindColumnsConsistent for the per-Kind null pattern and LiftFinalize for the gate.
    Kind text check (Kind in ('direct','lift')) default 'direct',  -- direct chit vs finalized lift chit
    LiftId text null,            -- Kind='lift' only: the PendingLift being finalized
    RefereeSignature text null,  -- Kind='lift' only: referee commit signature over the lift-terms digest

    primary key (Number),
    -- Kind='direct' only: SignerKey resolves against the issuing party's own authorized set. A finalize
    -- (Kind='lift') carries no fresh issuer signature -- it is authorized by LiftFinalize (referee commit +
    -- pre-signed pledge). This also fixes the draft placeholder that passed IssuerSid as the key argument.
    constraint SignerAuthorized check on insert (
        New.Kind = 'lift'
        or New.SignerKey in (
            select PublicKey from AuthorizedKey AK
            where AK.Sid = (select case when New.Issuer = 'S' then StockSid else FoilSid end from TallyCore)
        )
    ),
    -- Kind='direct' only: issuer chit signature over the chit digest. (Kind='lift' verifies the referee
    -- signature in LiftFinalize instead.)
    constraint SignatureValid check on insert (
        New.Kind = 'lift'
        or SignatureValid(
            Digest(
                Id,
                Issuer,
                (select case when Issuer = 'F' then FoilSid else StockSid end RecipientSid from TallyCore),
                Units,
                Date,
                Reference,
                Memo,
                InvoiceId
            ), Signature, New.SignerKey)
    ),
    -- Applies to EVERY Ledger row (direct + finalized lift both carry a real signed delta): the running
    -- Balance chains contiguously off the prior row.
    constraint BalanceCorrect check on insert (
        Coalesce((select Balance from Ledger where Number = Number - 1), 0)
            + (Units * case when Issuer = 'F' then 1 else -1 end) = Balance
    ),
    -- Credit gate. The prospective (stock-perspective) Balance must sit within the credit each
    -- party extended, effective as of THIS chit's own signed Date -- deterministic, no now().
    -- Stock-granted limit caps how far Balance may RISE (foil's debt to stock); foil-granted limit
    -- caps how far it may FALL (stock's debt to foil). Effective limit for a grantor = CreditLimit
    -- of the highest-Revision CreditTerms row whose EffectiveDate <= chit Date; absent any row -> 0
    -- (MyCHIPs zero-credit default -- a party must publish a CreditTerms revision before the first
    -- nonzero chit can move against it). Picking max-Revision among effective rows is correct even
    -- when a future-dated restrictive revision and a later immediate permissive revision coexist:
    -- the permissive one, once effective, has the higher revision and supersedes.
    -- This gate sees only SETTLED value. Pending lift chits are NO LONGER "in Balance by construction":
    -- a pledge reserves capacity in the separate ReservedBalance view and does not enter this settled
    -- chain until it FINALIZES -- concurrent pending lifts are gated separately by WithinReservedCredit
    -- (below, and on PendingLift). A referee-committed FINALIZE (Kind='lift') is EXEMPT from this gate
    -- (decision 3): once the referee has committed, the finalize row must always settle, or a per-strand
    -- credit check could reject a finalize the other strands accept -- breaking cross-strand atomicity.
    -- The pledge was already reserved-gated at insert; the referee commit is authoritative. This can push
    -- the settled Balance past the nominal limit (soft-limit NOTE) -- accepted: a committed lift is binding.
    -- NOTE: gate keys off the issuer-signed New.Date, which is unconstrained (no Date/Number
    -- monotonicity on Ledger) and chits are unilateral (issuer-signed only -- this CHECK is the SOLE
    -- enforcement, no counterparty countersignature). An issuer can therefore backdate a chit to a
    -- pre-reduction date to select an older, higher effective limit and exceed the limit now in force,
    -- defeating restrictive-change notice. Design decision tracked in
    -- backlog/debt-credit-gate-chit-date-backdating (bound Date, gate on now(), or accept as disputable).
    constraint WithinCreditLimits check on insert (
        New.Kind = 'lift'
        or (
            Balance <= coalesce((
                select CT.CreditLimit from CreditTerms CT
                where CT.Sid = (select StockSid from TallyCore)
                  and julianday(CT.EffectiveDate) <= julianday(New.Date)
                order by CT.Revision desc limit 1), 0)
            and Balance >= -coalesce((
                select CT.CreditLimit from CreditTerms CT
                where CT.Sid = (select FoilSid from TallyCore)
                  and julianday(CT.EffectiveDate) <= julianday(New.Date)
                order by CT.Revision desc limit 1), 0)
        )
    ),
    -- Reserved-credit gate (Kind='direct' only): the prospective RESERVED balance -- settled Balance (this
    -- chit included, it is the latest Ledger row) + every open pending-lift delta -- must also sit within
    -- both parties' limits as of New.Date, so a direct chit cannot consume capacity an open pledge reserved.
    -- ReservedBalance is read with a plain ref, so the buffered new row is already in its settled term. Same
    -- limit lookup as WithinCreditLimits. Kind='lift' is exempt (the finalize is authoritative, see above).
    constraint WithinReservedCredit check on insert (
        New.Kind = 'lift'
        or (
            (select Balance from ReservedBalance) <= coalesce((
                select CT.CreditLimit from CreditTerms CT
                where CT.Sid = (select StockSid from TallyCore)
                  and julianday(CT.EffectiveDate) <= julianday(New.Date)
                order by CT.Revision desc limit 1), 0)
            and (select Balance from ReservedBalance) >= -coalesce((
                select CT.CreditLimit from CreditTerms CT
                where CT.Sid = (select FoilSid from TallyCore)
                  and julianday(CT.EffectiveDate) <= julianday(New.Date)
                order by CT.Revision desc limit 1), 0)
        )
    ),
    -- Closing gate (feat-schema-tally-close): while any CloseRequest is filed, a new DIRECT chit may only
    -- move the settled balance TOWARD zero -- no new credit in either direction. Finalized lifts (Kind='lift')
    -- are EXEMPT, same reasoning as WithinCreditLimits / WithinReservedCredit: a referee-committed finalize
    -- must always settle or cross-strand atomicity breaks; the pledge was gated when made. P = prior settled
    -- balance (matching BalanceCorrect's reference form), B = New.Balance. Same-sign / bounded form, no abs()
    -- (Quereus scalar-abs availability unconfirmed): reduce a positive balance toward 0, or a negative one
    -- toward 0, and forbid a sign-flip overshoot (a chit flipping +30 -> -5 would mint new opposite-direction
    -- credit). At P = 0 both arms are false => every insert rejected, which is exactly the Closed "no further
    -- ledger inserts" rule -- no separate constraint. Inlined per use.
    -- NOTE: commit-time deferred CHECK reading `exists (select 1 from CloseRequest)` -- a balance-growing chit
    -- whose transaction read-snapshot predates the close-request commit could slip through under snapshot-only
    -- validation. SAME open isolation question already flagged for PartyKeyRevocation.NotLastKey
    -- (schema/draft1.qsql:137-146) and Ledger.InvoiceLink / LiftFinalize; not re-solved here.
    constraint ClosingReducesBalance check on insert (
        New.Kind = 'lift'                                                               -- finalize exempt (atomicity)
        or not exists (select 1 from CloseRequest)                                      -- not Closing -> unrestricted
        or (Coalesce((select Balance from Ledger where Number = New.Number - 1), 0) > 0 -- reduce positive toward 0
            and New.Balance >= 0
            and New.Balance < Coalesce((select Balance from Ledger where Number = New.Number - 1), 0))
        or (Coalesce((select Balance from Ledger where Number = New.Number - 1), 0) < 0 -- reduce negative toward 0
            and New.Balance <= 0
            and New.Balance > Coalesce((select Balance from Ledger where Number = New.Number - 1), 0))
    ),
    -- Kind='direct' only.
    -- NOTE (pre-existing, unrelated to lifts): this references IssuerSid, but the column is Issuer ('S'/'F')
    -- and there is no IssuerSid column -- looks like a draft placeholder. NOT touched by this ticket (out of
    -- scope for lift chits); flagged in the feat-schema-lift-chits review handoff for separate triage.
    constraint ValidIssuer check on insert (New.Kind = 'lift' or IssuerSid in (select StockSid from TallyCore)),
    -- If this chit answers an invoice: the invoice must exist, the chit must be issued by the PAYER
    -- (opposite side from the requester -- a foil-issued chit raises Balance toward stock, so if Stock
    -- requested payment Foil must issue), pledge EXACTLY the invoiced Units (partial payment is
    -- DISALLOWED -- one invoice, one chit, exact amount; see feat-schema-invoices), be the ONLY chit
    -- answering it, and the invoice must not already be declined. A plain (buffered+committed) ref on
    -- the count includes this new row -> exactly one match for a valid first payment.
    -- NOTE: concurrency. Two chits referencing the same invoice get different Ledger.Number, so they do
    -- NOT collide on the primary key; the `count(*) = 1` guard rejects the second only if this deferred
    -- CHECK is re-evaluated against the latest committed snapshot at commit. Pay-then-decline vs
    -- decline-then-pay races (this guard vs InvoiceDecline.NotPaid) have the same shape. This is the SAME
    -- open isolation question already flagged for PartyKeyRevocation.NotLastKey (schema/draft1.qsql:137-146):
    -- if Optimystic validates only against each transaction's original read snapshot, both could commit.
    -- Both racing actions are the payer's own, so it only ever produces self-inflicted ambiguity, and
    -- InvoiceState resolves it deterministically (paid > declined). Not solved here; confirm the isolation
    -- model when a runner exists, same as the NotLastKey note.
    -- Lift resolution joins this SAME open isolation list: LiftFinalize's NotVoided / single-finalize
    -- clauses and LiftVoid.NotFinalized are commit-time deferred CHECKs with the identical shape (two
    -- agents finalizing one lift, or a finalize racing a void, only reject if the CHECK re-evaluates
    -- against the latest committed snapshot). Same question, not re-solved here.
    -- Kind='direct' only (a finalize carries InvoiceId null and never answers an invoice).
    constraint InvoiceLink check on insert (
        New.Kind = 'lift'
        or New.InvoiceId is null
        or (
            exists (select 1 from Invoice where Id = New.InvoiceId)
            and New.Issuer <> (select Requester from Invoice where Id = New.InvoiceId)
            and New.Units = (select Units from Invoice where Id = New.InvoiceId)
            and (select count(*) from Ledger where InvoiceId = New.InvoiceId) = 1
            and not exists (select 1 from InvoiceDecline where InvoiceId = New.InvoiceId)
        )
    ),
    -- Finalize gate (Kind='lift' only): a referee commit signature settles a PendingLift pledge as this
    -- fresh Ledger row. The leading `exists` guard is LOAD-BEARING -- a Quereus CHECK passes when its
    -- expression is NULL (only a definite FALSE rejects; see TallyContract.DenominationImmutable and
    -- quereus runtime/emit/constraint-check.ts). Without it, a finalize naming a non-existent LiftId leaves
    -- every `pending.*` sub-select NULL and the whole check NULL -> ACCEPT; the guard forces a definite FALSE.
    --   (a) a matching PendingLift pledge exists for New.LiftId;
    --   (b) Issuer/Units/Date equal the pledge's, so the settled delta AND the referee digest match it;
    --   (c) the referee commit signature verifies against the pledge's RefereeKey over the lift-terms digest
    --       (field order per the PendingLift.SignatureValid protocol-contract NOTE) -- binding Cid + LiftId
    --       makes a commit signed for another tally or another lift impossible to replay here;
    --   (d) NotVoided: no LiftVoid for this LiftId (finalize-after-void rejected), AND no prior finalize:
    --       Ledger's PK is Number, so a second 'lift' row for the same LiftId does NOT collide on the PK --
    --       this self-count (plain ref = buffered+committed -> 1 for a valid first finalize) rejects the second.
    -- Kind='lift' is EXEMPT from both credit gates above (decision 3): a referee-committed finalize must
    -- always settle. Isolation caveat on the NotVoided / single-finalize clauses: see the InvoiceLink note.
    constraint LiftFinalize check on insert (
        New.Kind = 'direct'
        or (
            exists (select 1 from PendingLift where LiftId = New.LiftId)
            and New.Issuer = (select Issuer from PendingLift where LiftId = New.LiftId)
            and New.Units  = (select Units  from PendingLift where LiftId = New.LiftId)
            and New.Date   = (select Date   from PendingLift where LiftId = New.LiftId)
            and SignatureValid(
                Digest(
                    (select Cid from TallyCore),
                    New.LiftId,
                    (select RefereeKey from PendingLift where LiftId = New.LiftId),
                    New.Issuer,
                    New.Units,
                    New.Date,
                    (select Expiry from PendingLift where LiftId = New.LiftId)
                ),
                New.RefereeSignature,
                (select RefereeKey from PendingLift where LiftId = New.LiftId)
            )
            and not exists (select 1 from LiftVoid V where V.LiftId = New.LiftId)
            and (select count(*) from Ledger L where L.LiftId = New.LiftId and L.Kind = 'lift') = 1
        )
    ),
    -- Null-hygiene across Kind. A direct chit carries a fresh issuer signature and no lift fields; a
    -- finalize carries the lift fields, no issuer signature, and never answers an invoice. Written as a
    -- disjunction so a NULL Kind (which the column-level `Kind in (...)` check would let pass, since a CHECK
    -- passes on NULL) makes BOTH arms FALSE -> definite reject; a malformed row of either kind is rejected.
    constraint KindColumnsConsistent check on insert (
        (New.Kind = 'direct'
            and New.LiftId is null and New.RefereeSignature is null
            and New.SignerKey is not null and New.Signature is not null)
        or (New.Kind = 'lift'
            and New.LiftId is not null and New.RefereeSignature is not null
            and New.SignerKey is null and New.Signature is null and New.InvoiceId is null)
    ),
    constraint InsertOnly check on delete, update (0)
);

-- Conditional lift pledge on this edge (feat-schema-lift-chits). A lift clears credit around a cycle (or
-- along a chain) in the tally graph: every participant pays one neighbor and is paid by another, net zero,
-- but balances move back toward each party's target. Each tally on the route is one edge; ChipNet
-- coordinates the whole route under a single agreed referee whose commit signature is the atomic-commit
-- trigger. There is NO cross-strand transaction -- atomicity comes from every strand independently
-- verifying the SAME referee signature. So this row is a CONDITIONAL, issuer-signed pledge: it RESERVES
-- capacity (via ReservedBalance) while open but does not move the settled Balance; it enters the settled
-- Ledger only if the referee commits (a fresh Ledger row, Kind='lift'), or is voided by LiftVoid. Pending
-- pledge and its resolution are the "pending row + resolution row" pattern -- BalanceCorrect never sees a
-- pending delta, so the settled chain stays contiguous and every Ledger row carries real settled value.
-- NOTE (liveness gap): if the chosen referee becomes permanently unreachable, an open PendingLift reserves
-- capacity forever -- no party can void it alone without breaking atomicity (one edge voiding while
-- referee-committed others finalize). Inherent to a referee-arbitrated, no-cross-strand-transaction model;
-- referee reliability is the mitigation. A bounded party-driven release is parked in
-- backlog/feat-lift-timeout-release -- do NOT add a unilateral party void here.
create table PendingLift (
    LiftId text,           -- globally-unique lift id (from the ChipNet route); one pending chit per lift per strand
    RefereeKey text,       -- agreed referee's public key; every resolution signature verifies against THIS key
    Issuer text check (Issuer in ('S','F')),  -- side pledging value on this edge (foil +Units, stock -Units, per BalanceCorrect)
    Units integer check (Units > 0),           -- edge amount in THIS tally's denomination (per the committed route's rates)
    Date text check (ValidDate(Date)),         -- pledge timestamp; the date the reserved-credit gate keys off
    Expiry text check (ValidDate(Expiry)),     -- advisory staleness bound + signed term; NOT a per-strand finalize gate (decision 2)
    SignerKey text,        -- authorized PartyKey of the issuing party
    Signature text,        -- issuer signs Digest(Cid, LiftId, RefereeKey, Issuer, Units, Date, Expiry)

    primary key (LiftId),
    -- SignerKey resolves against the issuing side's own authorized set (mirror Ledger.SignerAuthorized).
    constraint SignerAuthorized check on insert (New.SignerKey in (
        select PublicKey from AuthorizedKey AK
        where AK.Sid = (select case when New.Issuer = 'S' then StockSid else FoilSid end from TallyCore)
    )),
    -- Issuer pledge signature over the lift-terms digest.
    -- NOTE (protocol contract): this digest field order -- Cid, LiftId, RefereeKey, Issuer, Units, Date,
    -- Expiry -- is the SAME lift-terms digest the ChipNet referee signs at commit (see Ledger.LiftFinalize).
    -- It is a cross-component contract: feat-chipnet-integration MUST NOT drift from this order, or a valid
    -- referee commit will fail to verify against the pledge. The void digest is DISTINCT -- Digest(Cid,
    -- LiftId, 'void') (LiftVoid) -- so a commit signature can never be replayed as a void or vice versa.
    constraint SignatureValid check on insert (SignatureValid(
        Digest((select Cid from TallyCore), LiftId, RefereeKey, Issuer, Units, Date, Expiry),
        Signature,
        New.SignerKey
    )),
    constraint ExpiryValid check on insert (julianday(Expiry) >= julianday(Date)),
    -- Reserved-credit gate: the prospective RESERVED balance (settled + all open pending, INCLUDING this new
    -- pledge -- a plain ref to ReservedBalance already buffers it in) must sit within both parties' limits as
    -- of New.Date. Same limit lookup as Ledger.WithinCreditLimits (highest-Revision CreditTerms row whose
    -- EffectiveDate <= New.Date, per grantor; absent -> 0). This is the reserved-capacity gate that stops
    -- concurrent lifts from collectively over-committing. Soft under concurrency -- see the isolation NOTE
    -- shared with Ledger.LiftFinalize / PartyKeyRevocation.NotLastKey; a committed finalize is never re-gated.
    constraint WithinReservedCredit check on insert (
        (select Balance from ReservedBalance) <= coalesce((
            select CT.CreditLimit from CreditTerms CT
            where CT.Sid = (select StockSid from TallyCore)
              and julianday(CT.EffectiveDate) <= julianday(New.Date)
            order by CT.Revision desc limit 1), 0)
        and (select Balance from ReservedBalance) >= -coalesce((
            select CT.CreditLimit from CreditTerms CT
            where CT.Sid = (select FoilSid from TallyCore)
              and julianday(CT.EffectiveDate) <= julianday(New.Date)
            order by CT.Revision desc limit 1), 0)
    ),
    -- Closing gate (feat-schema-tally-close): while any CloseRequest is filed, a new pledge may only move the
    -- RESERVED balance TOWARD zero -- mirrors putting the direct-chit gate on settled, the pledge gate on
    -- reserved (same split as the two credit gates). ReservedBalance read with a plain ref already includes
    -- this new pledge, so NR = reserved WITH this pledge, D = New.Units * (F:+1, S:-1) = this pledge's delta,
    -- PR = NR - D = prior reserved. Same-sign / bounded form, no abs(). No finalize exemption applies (a
    -- PendingLift insert is always a fresh pledge, never a finalize; LiftVoid needs no gate -- a void only
    -- releases reservation). NR / D / PR inlined per use.
    -- NOTE: commit-time deferred CHECK reading `exists (select 1 from CloseRequest)` -- SAME open isolation
    -- question already flagged for PartyKeyRevocation.NotLastKey (schema/draft1.qsql:137-146) and the
    -- WithinReservedCredit gate above; not re-solved here.
    constraint ClosingReducesReserved check on insert (
        not exists (select 1 from CloseRequest)
        or ((select Balance from ReservedBalance) - (New.Units * case when New.Issuer = 'F' then 1 else -1 end) > 0  -- PR > 0
            and (select Balance from ReservedBalance) >= 0                                                           -- NR >= 0
            and (select Balance from ReservedBalance) < (select Balance from ReservedBalance) - (New.Units * case when New.Issuer = 'F' then 1 else -1 end))  -- NR < PR
        or ((select Balance from ReservedBalance) - (New.Units * case when New.Issuer = 'F' then 1 else -1 end) < 0  -- PR < 0
            and (select Balance from ReservedBalance) <= 0                                                           -- NR <= 0
            and (select Balance from ReservedBalance) > (select Balance from ReservedBalance) - (New.Units * case when New.Issuer = 'F' then 1 else -1 end))  -- NR > PR
    ),
    constraint InsertOnly check on delete, update (0)
);

-- Referee-signed void of a pending lift (feat-schema-lift-chits): an explicit abort OR a post-timeout void
-- -- the SAME mechanism (decision 2). The referee is the sole arbiter; parties NEVER unilaterally void, so
-- one referee signature resolves every strand the same way and cross-strand atomicity holds with no
-- cross-strand transaction. Voiding writes NO settled Ledger row -- the pledge simply drops out of
-- OpenPendingLift, releasing its reserved capacity. Mutual exclusion with finalize is enforced both ways
-- (NotFinalized here; LiftFinalize.NotVoided there); double-void collides on the primary key.
create table LiftVoid (
    LiftId text,             -- one void per lift; PK also blocks double-void
    RefereeSignature text,   -- referee signs Digest(Cid, LiftId, 'void') -- DISTINCT from the commit digest

    primary key (LiftId),
    -- The pledge being voided must exist. `in (subquery)` over a non-null PK column yields a definite FALSE
    -- (not NULL) when absent, so this rejects a void with no pledge and shields RefereeVoidValid's sub-select.
    constraint PendingExists check on insert (New.LiftId in (select LiftId from PendingLift)),
    -- Mutual exclusion with finalize: no settled lift row may already exist for this LiftId. Commit-time
    -- deferred CHECK; same Optimystic isolation caveat as Ledger.LiftFinalize / InvoiceLink / NotLastKey.
    constraint NotFinalized check on insert (not exists (select 1 from Ledger L where L.LiftId = New.LiftId and L.Kind = 'lift')),
    -- Referee void signature over the DISTINCT void digest, verified against the pledge's RefereeKey. The
    -- distinct digest is what makes a commit signature un-replayable as a void (and vice versa). PendingExists
    -- guarantees the RefereeKey sub-select is a definite value here.
    constraint RefereeVoidValid check on insert (SignatureValid(
        Digest((select Cid from TallyCore), New.LiftId, 'void'),
        New.RefereeSignature,
        (select RefereeKey from PendingLift where LiftId = New.LiftId)
    )),
    constraint InsertOnly check on delete, update (0)
);

